{
  "name": "dsh-cost-governor",
  "version": "0.1.0",
  "description": "Cost governance & budget enforcement for DeepSeek Harness: multi-provider pricing, per-model cost accounting, budget quotas with soft/hard thresholds, and cross-session trends.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "budget",
    "token",
    "pricing",
    "governance",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-cost-governor/dsh-cost-governor.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-session-projection": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "zod": "^4.4.0",
    "react": "^18.0.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-projection": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
